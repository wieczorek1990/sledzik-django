[Unit]
Description=Śledzik Django ASGI Application
After=network.target

[Service]
Type=simple
User=sledzik
Group=sledzik
WorkingDirectory=/opt/sledzik
EnvironmentFile=/opt/sledzik/bin/envs.sh
ExecStart=/opt/sledzik/.venv/bin/daphne -e "tcp:8000:interface=127.0.0.1" śledzik.asgi:application
Restart=always
RestartSec=5
StandardOutput=append:/var/log/sledzik/sledzik.log
StandardError=append:/var/log/sledzik/sledzik-error.log

[Install]
WantedBy=multi-user.target
